{
	"name": "@ayka/fiji",
	"version": "2.0.0-rc.11",
	"description": "@ayka/fiji is a configuration management library that provides a flexible and type-safe way to handle application configurations. It supports environment variables, default values, and secret management.",
	"keywords": [
		"config",
		"configuration",
		"management",
		"environment",
		"env",
		"dotenv",
		"secrets",
		"settings",
		"type-safe"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AndreyMork/fiji.git"
	},
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"import": "./dist/main.js",
			"require": "./dist/main.cjs"
		}
	},
	"files": [
		"dist/"
	],
	"engines": {
		"node": ">=18.0.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"prepack": "just prepack",
		"test": "just test",
		"preversion": "just full-check-strict prepack"
	},
	"dependencies": {
		"@ayka/domistrukt": "2.0.0-rc.31",
		"@glitchdotcom/dotenv": "^1.1.0",
		"immutable": "^5.1.4",
		"znv": "^0.5.0",
		"zod": "^3.24.1"
	},
	"devDependencies": {
		"@ayka/biome-config": "^2.1.0",
		"@ayka/tsconfig": "^1.2.0",
		"@biomejs/biome": "^2.3.7",
		"@japa/expect": "^3.0.6",
		"@japa/expect-type": "^2.0.3",
		"@japa/runner": "^4.4.0",
		"@stryker-mutator/core": "^9.3.0",
		"@stryker-mutator/typescript-checker": "^9.3.0",
		"@types/mock-fs": "^4.13.4",
		"@types/node": "^24.10.1",
		"c8": "^10.1.3",
		"fast-check": "^4.3.0",
		"mock-fs": "^5.5.0",
		"npm-check-updates": "^19.1.2",
		"prettier": "^3.6.2",
		"publint": "^0.3.15",
		"tsup": "^8.5.1",
		"tsx": "^4.20.6",
		"typedoc": "^0.28.14",
		"typedoc-plugin-markdown": "^4.9.0",
		"typescript": "^5.9.3"
	}
}
